{
  "name": "djvj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated, audio-reactive generative visuals for solo DJ sets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=22"
  }
}
